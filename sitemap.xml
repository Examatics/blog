---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign default_changefreq = "monthly" %}
{% assign default_priority = "0.8" %}
{% assign emitted_urls = "|" %}
{% assign site_pages = site.pages | sort: "url" %}
{% for page in site_pages %}
{% unless page.name == 'sitemap.xml' or page.sitemap == false or page.url == nil or page.url == '' %}
{% assign normalized_url = page.url | replace: 'index.html', '' %}
{% capture page_key %}|{{ normalized_url }}|{% endcapture %}
{% unless emitted_urls contains page_key %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ normalized_url }}</loc>
    <changefreq>{% if page.url == '/' %}weekly{% else %}{{ page.sitemap.changefreq | default: default_changefreq }}{% endif %}</changefreq>
    <priority>{% if page.url == '/' %}1.0{% else %}{{ page.sitemap.priority | default: default_priority }}{% endif %}</priority>
  </url>
{% assign emitted_urls = emitted_urls | append: normalized_url | append: '|' %}
{% endunless %}
{% endunless %}
{% endfor %}
{% assign posts = site.posts | sort: "url" %}
{% for post in posts %}
{% capture post_key %}|{{ post.url }}|{% endcapture %}
{% unless emitted_urls contains post_key %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ post.url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    <changefreq>{{ post.sitemap.changefreq | default: default_changefreq }}</changefreq>
    <priority>{{ post.sitemap.priority | default: "0.9" }}</priority>
  </url>
{% assign emitted_urls = emitted_urls | append: post.url | append: '|' %}
{% endunless %}
{% endfor %}
{% assign faq_entries = site.faq | sort: "url" %}
{% for entry in faq_entries %}
{% capture entry_key %}|{{ entry.url }}|{% endcapture %}
{% unless emitted_urls contains entry_key %}
  <url>
    <loc>{{ site.url }}{{ site.baseurl }}{{ entry.url }}</loc>
    <lastmod>{{ entry.date | default: site.time | date_to_xmlschema }}</lastmod>
    <changefreq>{{ entry.sitemap.changefreq | default: default_changefreq }}</changefreq>
    <priority>{{ entry.sitemap.priority | default: "0.7" }}</priority>
  </url>
{% assign emitted_urls = emitted_urls | append: entry.url | append: '|' %}
{% endunless %}
{% endfor %}
</urlset>
